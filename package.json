{
  "name": "jaiye-agent",
  "version": "0.2.0",
  "description": "Multi-agent coordination protocol for AI coding tools",
  "type": "module",
  "bin": {
    "jaiye-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "coordination",
    "multi-agent"
  ],
  "author": "Jaiye Labs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": ">=18",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
